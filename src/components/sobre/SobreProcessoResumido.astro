---
import sobrePagina from '../../content/sobre_pagina.json';
const pr = sobrePagina.processo_resumido;
---

<section class="processo">
  <div class="section-inner">
    <header class="processo-header">
      <p class="label">{pr.eyebrow}</p>
      <div class="gold-line"></div>
      <h2 class="processo-title">{pr.titulo}</h2>
    </header>
    <div class="processo-grid">
      {pr.colunas.map((col) => (
        <article class="processo-col">
          <p class="processo-num">{col.numero}</p>
          <div class="processo-divider"></div>
          <h3 class="processo-col-title">{col.titulo}</h3>
          <p class="processo-col-body">{col.descricao}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .processo {
    background: var(--branco);
    padding: 6rem 0 7rem;
  }

  .processo-header {
    margin-bottom: 4rem;
  }

  .processo-title {
    font-size: clamp(1.625rem, 2.5vw, 2.25rem);
    font-weight: 600;
    color: var(--verde);
    letter-spacing: -0.01em;
    max-width: 36ch;
  }

  .processo-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
  }

  .processo-col {
    padding: 0 3rem 0 0;
    border-right: 1px solid rgba(202, 155, 88, 0.15);
  }

  .processo-col:first-child {
    padding-left: 0;
  }

  .processo-col:last-child {
    padding-right: 0;
    border-right: none;
  }

  .processo-col:not(:first-child) {
    padding-left: 3rem;
  }

  .processo-num {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(3.5rem, 5.5vw, 5.5rem);
    color: var(--dourado);
    line-height: 1;
    letter-spacing: -0.02em;
    opacity: 0.7;
    margin-bottom: 1rem;
  }

  .processo-divider {
    width: 36px;
    height: 1.5px;
    background: var(--dourado);
    opacity: 0.5;
    margin-bottom: 1.5rem;
  }

  .processo-col-title {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--verde);
    line-height: 1.35;
    margin-bottom: 0.875rem;
    letter-spacing: -0.005em;
    font-family: var(--font-serif);
    font-style: normal;
  }

  .processo-col-body {
    font-size: 14px;
    font-weight: 300;
    line-height: 1.75;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .processo {
      padding: 4.5rem 0 5.5rem;
    }
    .processo-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .processo-col {
      padding: 0 0 2.5rem;
      border-right: none;
      border-bottom: 1px solid rgba(202, 155, 88, 0.15);
    }
    .processo-col:last-child {
      border-bottom: none;
      padding-bottom: 0;
    }
    .processo-col:not(:first-child) {
      padding-left: 0;
    }
    .processo-num {
      font-size: clamp(3rem, 12vw, 4.5rem);
    }
  }
</style>
