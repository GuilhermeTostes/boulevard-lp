<!-- Lightbox: overlay para galeria de projeto. Ativado via data-lightbox-src nas imgs. -->
<div id="lightbox" class="lightbox" hidden aria-modal="true" role="dialog" aria-label="Visualizador de imagens">
  <div class="lb-backdrop"></div>
  <button class="lb-close" aria-label="Fechar">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
      <line x1="18" y1="6" x2="6" y2="18"/>
      <line x1="6" y1="6" x2="18" y2="18"/>
    </svg>
  </button>
  <button class="lb-prev" aria-label="Imagem anterior">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="15 18 9 12 15 6"/>
    </svg>
  </button>
  <button class="lb-next" aria-label="Próxima imagem">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="9 18 15 12 9 6"/>
    </svg>
  </button>
  <img class="lb-img" src="" alt="" />
  <p class="lb-counter" aria-live="polite"></p>
</div>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 9999;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .lightbox:not([hidden]) {
    display: flex;
  }

  .lightbox.lb-visible {
    opacity: 1;
  }

  .lb-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(12, 24, 26, 0.96);
    cursor: zoom-out;
  }

  .lb-img {
    position: relative;
    z-index: 1;
    max-width: 90vw;
    max-height: 88vh;
    object-fit: contain;
    border-radius: 4px;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.5);
    cursor: default;
  }

  .lb-close,
  .lb-prev,
  .lb-next {
    position: absolute;
    z-index: 2;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: rgba(240, 239, 245, 0.9);
    border-radius: 50%;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s, color 0.2s, transform 0.2s;
  }

  .lb-close:hover,
  .lb-prev:hover,
  .lb-next:hover {
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
  }

  .lb-close:active,
  .lb-prev:active,
  .lb-next:active {
    transform: scale(0.93);
  }

  .lb-close {
    top: 20px;
    right: 20px;
  }

  .lb-prev {
    left: 20px;
    top: 50%;
    transform: translateY(-50%);
  }

  .lb-prev:active {
    transform: translateY(-50%) scale(0.93);
  }

  .lb-next {
    right: 20px;
    top: 50%;
    transform: translateY(-50%);
  }

  .lb-next:active {
    transform: translateY(-50%) scale(0.93);
  }

  .lb-counter {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.08em;
    color: rgba(240, 239, 245, 0.5);
  }

  @media (max-width: 480px) {
    .lb-prev { left: 10px; }
    .lb-next { right: 10px; }
    .lb-close { top: 12px; right: 12px; }
    .lb-prev,
    .lb-next,
    .lb-close {
      width: 40px;
      height: 40px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lightbox { transition: none; }
  }
</style>

<script>
  const lightbox = document.getElementById('lightbox') as HTMLElement;
  const lbImg = lightbox.querySelector('.lb-img') as HTMLImageElement;
  const lbCounter = lightbox.querySelector('.lb-counter') as HTMLElement;
  const lbClose = lightbox.querySelector('.lb-close') as HTMLButtonElement;
  const lbPrev = lightbox.querySelector('.lb-prev') as HTMLButtonElement;
  const lbNext = lightbox.querySelector('.lb-next') as HTMLButtonElement;
  const lbBackdrop = lightbox.querySelector('.lb-backdrop') as HTMLElement;

  const items = Array.from(document.querySelectorAll<HTMLImageElement>('[data-lightbox-src]'));
  let current = 0;
  let lastFocused: HTMLElement | null = null;

  function show(idx: number) {
    current = (idx + items.length) % items.length;
    const src = items[current].dataset.lightboxSrc ?? items[current].src;
    const alt = items[current].alt ?? '';
    lbImg.src = src;
    lbImg.alt = alt;
    lbCounter.textContent = `${current + 1} / ${items.length}`;
    lbPrev.style.display = items.length <= 1 ? 'none' : '';
    lbNext.style.display = items.length <= 1 ? 'none' : '';
  }

  function open(idx: number) {
    lastFocused = document.activeElement as HTMLElement;
    lightbox.hidden = false;
    document.body.style.overflow = 'hidden';
    show(idx);
    requestAnimationFrame(() => lightbox.classList.add('lb-visible'));
    lbClose.focus();
  }

  function close() {
    lightbox.classList.remove('lb-visible');
    setTimeout(() => {
      lightbox.hidden = true;
      document.body.style.overflow = '';
      lastFocused?.focus();
    }, 250);
  }

  items.forEach((img, idx) => {
    img.style.cursor = 'zoom-in';
    img.addEventListener('click', () => open(idx));
  });

  lbClose.addEventListener('click', close);
  lbBackdrop.addEventListener('click', close);
  lbPrev.addEventListener('click', () => show(current - 1));
  lbNext.addEventListener('click', () => show(current + 1));

  document.addEventListener('keydown', (e) => {
    if (lightbox.hidden) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowLeft') show(current - 1);
    if (e.key === 'ArrowRight') show(current + 1);
  });
</script>
