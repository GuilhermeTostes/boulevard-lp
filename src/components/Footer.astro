---
import configs from '../content/configs.json';

const anoAtual = new Date().getFullYear();
---

<footer id="footer" class="site-footer">
  <div class="section-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <img
          src="/assets/logo-horizontal-light.png"
          alt="Boulevard Arq & Con"
          class="footer-logo"
          height="44"
        />
        <p class="footer-tagline">{configs.tagline}</p>
      </div>
      <nav class="footer-col" aria-label="Links de navegação">
        <p class="col-title">Navegação</p>
        <div class="col-links">
          {configs.nav_links.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </div>
      </nav>
      <div class="footer-col">
        <p class="col-title">Contato</p>
        <div class="col-links">
          <a href={`mailto:${configs.contato_email}`}>{configs.contato_email}</a>
          <a href={`tel:${configs.contato_tel.replace(/\D/g,'')}`}>{configs.contato_tel}</a>
          <span>{configs.contato_local}</span>
          <a href={configs.social.instagram} rel="noopener noreferrer" target="_blank">Instagram</a>
          <a href={configs.social.linkedin} rel="noopener noreferrer" target="_blank">LinkedIn</a>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <span class="copy">© {anoAtual} Boulevard Arq &amp; Con. Todos os direitos reservados.</span>
      <span class="social-label">Instagram · LinkedIn</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--verde-dk);
    padding: 4rem 0 1.75rem;
    border-top: 1px solid rgba(240, 239, 245, 0.07);
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 4rem;
    padding-bottom: 2.75rem;
    border-bottom: 1px solid rgba(240, 239, 245, 0.08);
    margin-bottom: 1.5rem;
  }

  .footer-logo {
    display: block;
    height: 36px;
    width: auto;
    object-fit: contain;
    margin-bottom: 1rem;
  }

  .footer-tagline {
    font-size: 14px;
    font-weight: 300;
    color: rgba(240, 239, 245, 0.6);
    line-height: 1.7;
    max-width: 220px;
  }

  .col-title {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dourado);
    margin-bottom: 1.125rem;
  }

  .col-links {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .col-links a,
  .col-links span {
    font-size: 15px;
    font-weight: 300;
    color: rgba(240, 239, 245, 0.7);
    transition: color 0.2s var(--ease-premium);
  }

  .col-links a:hover {
    color: var(--offwhite);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .copy {
    font-size: 11px;
    color: rgba(240, 239, 245, 0.28);
    letter-spacing: 0.03em;
  }

  .social-label {
    font-size: 11px;
    color: rgba(240, 239, 245, 0.28);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (max-width: 768px) {
    .site-footer {
      padding: 3.5rem 0 1.5rem;
    }
    .footer-top {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.375rem;
    }
  }
</style>
