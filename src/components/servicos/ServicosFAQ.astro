---
import servicos from '../../content/servicos.json';
const { faq } = servicos;
---

<section class="faq">
  <div class="section-inner">
    <header class="faq-header">
      <p class="label">{faq.eyebrow}</p>
      <div class="gold-line"></div>
      <h2 class="faq-title">{faq.titulo}</h2>
    </header>
    <div class="faq-list">
      {faq.itens.map((item) => (
        <details class="faq-item">
          <summary class="faq-question">
            <span>{item.pergunta}</span>
            <span class="faq-icon" aria-hidden="true"></span>
          </summary>
          <div class="faq-answer">
            <p>{item.resposta}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    background: var(--branco);
    padding: 6rem 0 7rem;
  }

  .faq-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .faq-header .gold-line {
    margin-left: auto;
    margin-right: auto;
  }

  .faq-title {
    font-size: clamp(1.875rem, 3vw, 2.5rem);
    font-weight: 600;
    color: var(--verde);
    letter-spacing: -0.01em;
  }

  .faq-list {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
  }

  .faq-item {
    border-bottom: 1px solid rgba(202, 155, 88, 0.2);
  }

  .faq-item:first-child {
    border-top: 1px solid rgba(202, 155, 88, 0.2);
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.375rem 0;
    font-size: 16px;
    font-weight: 500;
    color: var(--verde);
    cursor: pointer;
    list-style: none;
    transition: color 0.3s var(--ease-premium);
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-item[open] > .faq-question {
    color: var(--dourado);
  }

  .faq-icon {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    position: relative;
  }

  .faq-icon::before,
  .faq-icon::after {
    content: '';
    position: absolute;
    background: var(--dourado);
    border-radius: 1px;
    transition:
      transform 0.35s var(--ease-premium),
      opacity 0.35s var(--ease-premium);
  }

  /* barra vertical do + */
  .faq-icon::before {
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1.5px;
    transform: translateX(-50%);
  }

  /* barra horizontal do + */
  .faq-icon::after {
    top: 50%;
    left: 0;
    right: 0;
    height: 1.5px;
    transform: translateY(-50%);
  }

  /* aberto: barra vertical gira e desaparece → fica só − */
  .faq-item[open] .faq-icon::before {
    transform: translateX(-50%) rotate(90deg);
    opacity: 0;
  }

  .faq-answer {
    padding: 0 0 1.375rem;
    max-width: 72ch;
  }

  .faq-answer p {
    font-size: 15px;
    font-weight: 300;
    line-height: 1.8;
    color: var(--muted);
  }

  @media (max-width: 768px) {
    .faq {
      padding: 4.5rem 0 5.5rem;
    }
    .faq-question {
      font-size: 15px;
      padding: 1.125rem 0;
    }
  }
</style>
