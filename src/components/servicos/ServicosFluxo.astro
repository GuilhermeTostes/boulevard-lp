---
import servicos from '../../content/servicos.json';

const f = servicos.fluxo;

let alternating = 0;
const steps = f.etapas.map((etapa, idx) => {
  const isHighlight = etapa.destaque && etapa.destaque !== '';
  let side: 'left' | 'right' | 'center' = 'center';
  if (!isHighlight) {
    side = alternating % 2 === 0 ? 'left' : 'right';
    alternating++;
  }
  return {
    ...etapa,
    numero: String(idx + 1).padStart(2, '0'),
    isHighlight,
    side,
  };
});
---

<section class="fluxo">
  <div class="fluxo-watermark" aria-hidden="true">
    <img src="/assets/symbol-gold.png" alt="" width="440" height="440" />
  </div>
  <div class="section-inner">
    <header class="fluxo-header">
      <p class="label">{f.eyebrow}</p>
      <div class="gold-line"></div>
      <h2 class="fluxo-title">{f.titulo}</h2>
      {f.subtitulo && <p class="fluxo-sub">{f.subtitulo}</p>}
    </header>

    <ol class="fluxo-list">
      {steps.map((step, i) => (
        <li
          class={`step step--${step.side} ${step.isHighlight ? `step--highlight step--${step.destaque}` : ''}`}
          style={`--i:${i}`}
        >
          <span class="step-marker" aria-hidden="true">
            <span class="step-marker-num">{step.numero}</span>
          </span>
          <article class="step-card">
            {step.isHighlight && step.destaque === 'virada' && (
              <p class="step-tag">Ponto de virada</p>
            )}
            {step.isHighlight && step.destaque === 'inicio' && (
              <p class="step-tag">Ponto de partida</p>
            )}
            {step.isHighlight && step.destaque === 'fim' && (
              <p class="step-tag">Entrega final</p>
            )}
            <h3 class="step-title">{step.titulo}</h3>
            <p class="step-body">{step.descricao}</p>
          </article>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .fluxo {
    background: var(--branco);
    padding: 7rem 0 8rem;
    position: relative;
    overflow: hidden;
  }

  .fluxo-watermark {
    position: absolute;
    left: clamp(-340px, -18vw, -200px);
    bottom: clamp(-260px, -12vw, -160px);
    width: min(1040px, 78vw);
    aspect-ratio: 1;
    opacity: 0.045;
    pointer-events: none;
    user-select: none;
  }

  .fluxo-watermark img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .fluxo-header {
    text-align: center;
    margin-bottom: 4.5rem;
  }

  .fluxo-header .gold-line {
    margin-left: auto;
    margin-right: auto;
  }

  .fluxo-title {
    font-size: clamp(1.875rem, 3vw, 2.5rem);
    font-weight: 600;
    color: var(--verde);
    letter-spacing: -0.01em;
    margin-bottom: 1rem;
    max-width: 22ch;
    margin-left: auto;
    margin-right: auto;
  }

  .fluxo-sub {
    font-size: 16px;
    font-weight: 300;
    line-height: 1.75;
    color: var(--muted);
    max-width: 56ch;
    margin: 0 auto;
  }

  /* ── Timeline ─────────────────────────────────────────── */
  .fluxo-list {
    list-style: none;
    position: relative;
    margin: 0 auto;
    max-width: 1100px;
    padding: 1rem 0;
  }

  .fluxo-list::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1.5px;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(202, 155, 88, 0.6) 8%,
      rgba(202, 155, 88, 0.6) 92%,
      transparent 100%
    );
    transform: translateX(-50%);
  }

  .step {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 80px 1fr;
    align-items: center;
    margin-bottom: 2rem;
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.7s var(--ease-premium) calc(var(--i, 0) * 60ms),
      transform 0.7s var(--ease-premium) calc(var(--i, 0) * 60ms);
  }

  .step:last-child {
    margin-bottom: 0;
  }

  .step.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .step-marker {
    grid-column: 2;
    grid-row: 1;
    justify-self: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--branco);
    border: 1.5px solid rgba(202, 155, 88, 0.55);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
    box-shadow: 0 0 0 6px var(--branco);
    transition:
      transform 0.4s var(--ease-premium),
      border-color 0.4s var(--ease-premium),
      background 0.4s var(--ease-premium);
  }

  .step-marker-num {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: 14px;
    color: var(--dourado);
    letter-spacing: 0.02em;
  }

  .step-card {
    background: var(--branco);
    border: 1px solid rgba(33, 62, 64, 0.1);
    border-radius: 12px;
    padding: 1.5rem 1.75rem;
    max-width: 360px;
    transition:
      box-shadow 0.4s var(--ease-premium),
      transform 0.4s var(--ease-premium),
      border-color 0.4s var(--ease-premium);
    position: relative;
  }

  .step-card:hover {
    box-shadow: 0 14px 40px rgba(33, 62, 64, 0.08);
    transform: translateY(-2px);
    border-color: rgba(202, 155, 88, 0.45);
  }

  .step--left .step-card {
    grid-column: 1;
    grid-row: 1;
    justify-self: end;
  }

  .step--right .step-card {
    grid-column: 3;
    grid-row: 1;
    justify-self: start;
  }

  .step--left .step-card::after,
  .step--right .step-card::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 30px;
    height: 1px;
    background: rgba(202, 155, 88, 0.45);
    transform: translateY(-50%);
  }

  .step--left .step-card::after {
    right: -30px;
  }

  .step--right .step-card::after {
    left: -30px;
  }

  .step-tag {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--dourado);
    margin-bottom: 0.5rem;
  }

  .step-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--verde);
    line-height: 1.3;
    margin-bottom: 0.625rem;
    letter-spacing: -0.005em;
  }

  .step-body {
    font-size: 14px;
    font-weight: 300;
    line-height: 1.7;
    color: var(--muted);
  }

  /* ── Highlights ───────────────────────────────────────── */
  .step--highlight {
    margin: 3rem 0;
  }

  .step--highlight .step-card {
    grid-column: 1 / -1;
    grid-row: 1;
    justify-self: center;
    max-width: 640px;
    text-align: center;
    padding: 2.5rem 3rem;
  }

  .step--highlight .step-marker {
    display: none;
  }

  .step--inicio .step-card {
    background: var(--branco);
    border: 1px solid rgba(202, 155, 88, 0.45);
    box-shadow: 0 16px 50px rgba(33, 62, 64, 0.08);
  }

  .step--inicio .step-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 64px;
    height: 2px;
    background: var(--dourado);
  }

  .step--inicio .step-title {
    font-size: 1.5rem;
  }

  .step--virada .step-card {
    background: var(--verde);
    border: 1px solid rgba(202, 155, 88, 0.4);
    box-shadow: 0 22px 60px rgba(33, 62, 64, 0.18);
    position: relative;
  }

  .step--virada .step-card::before,
  .step--virada .step-card::after {
    content: '';
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    width: 64px;
    height: 1.5px;
    background: var(--dourado);
  }

  .step--virada .step-card::before {
    top: 1.25rem;
  }

  .step--virada .step-card::after {
    bottom: 1.25rem;
  }

  .step--virada .step-title {
    color: var(--offwhite);
    font-size: 1.5rem;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    letter-spacing: 0.005em;
  }

  .step--virada .step-body {
    color: rgba(240, 239, 245, 0.78);
    font-size: 15px;
  }

  .step--virada .step-tag {
    color: var(--dourado);
  }

  .step--fim .step-card {
    background: var(--branco);
    border: 1px solid rgba(202, 155, 88, 0.45);
    box-shadow: 0 16px 50px rgba(33, 62, 64, 0.08);
  }

  .step--fim .step-card::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 64px;
    height: 2px;
    background: var(--dourado);
  }

  .step--fim .step-title {
    font-size: 1.5rem;
  }

  /* ── Mobile ─────────────────────────────────────────────── */
  @media (max-width: 900px) {
    .fluxo {
      padding: 5rem 0 6rem;
    }
    .fluxo-header {
      margin-bottom: 3rem;
      text-align: left;
    }
    .fluxo-header .gold-line {
      margin-left: 0;
    }
    .fluxo-title,
    .fluxo-sub {
      margin-left: 0;
      margin-right: 0;
    }

    .fluxo-list::before {
      left: 22px;
    }

    .step {
      grid-template-columns: 44px 1fr;
      gap: 0.75rem;
      margin-bottom: 1.25rem;
    }

    .step-marker {
      grid-column: 1;
      box-shadow: 0 0 0 4px var(--branco);
    }

    .step--left .step-card,
    .step--right .step-card,
    .step--highlight .step-card {
      grid-column: 2;
      grid-row: 1;
      justify-self: stretch;
      max-width: none;
      text-align: left;
      padding: 1.25rem 1.25rem;
    }

    .step--left .step-card::after,
    .step--right .step-card::after {
      display: none;
    }

    .step--highlight {
      margin: 2rem 0;
    }

    .step--highlight .step-marker {
      display: flex;
    }

    .step--virada .step-card::before,
    .step--virada .step-card::after,
    .step--inicio .step-card::before,
    .step--fim .step-card::after {
      left: 1.25rem;
      transform: none;
      width: 36px;
    }

    .step--virada .step-title,
    .step--inicio .step-title,
    .step--fim .step-title {
      font-size: 1.2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .step {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const steps = document.querySelectorAll<HTMLElement>('.fluxo .step');

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        (entry.target as HTMLElement).classList.add('is-visible');
        observer.unobserve(entry.target);
      });
    },
    { threshold: 0.2 }
  );

  steps.forEach((s) => observer.observe(s));
</script>
