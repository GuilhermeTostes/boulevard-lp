---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Lightbox from '../../components/Lightbox.astro';
import CtaFinal from '../../components/CtaFinal.astro';

export async function getStaticPaths() {
  const projetos = await getCollection('projetos');
  return projetos.map((projeto) => ({
    params: { slug: projeto.id },
    props: { projeto },
  }));
}

const { projeto } = Astro.props;
const { Content } = await render(projeto);

// Links prev/next
const allProjetos = (await getCollection('projetos')).sort(
  (a, b) => a.data.ordem - b.data.ordem
);
const idx = allProjetos.findIndex((p) => p.id === projeto.id);
const prev = allProjetos[idx - 1];
const next = allProjetos[idx + 1];
---

<Layout
  title={`${projeto.data.title} — Boulevard Arq & Con`}
  description={projeto.data.descricao_curta}
  image={projeto.data.imagem_capa}
>
  <Header />
  <main class="projeto-page">

    <!-- Hero do projeto -->
    <div class="proj-hero">
      <div
        class="proj-hero-bg"
        style={`background-image: url('${projeto.data.imagem_capa}')`}
      ></div>
      <div class="proj-hero-overlay"></div>
      <div class="proj-hero-content section-inner">
        <p class="label">{projeto.data.tag}</p>
        <div class="gold-line" style="margin: 12px 0 20px"></div>
        <h1>{projeto.data.title}</h1>
        <p class="proj-meta">{projeto.data.localizacao} — {projeto.data.ano}</p>
      </div>
    </div>

    <!-- Corpo do projeto -->
    <div class="proj-body section-inner">
      <div class="proj-content prose">
        <p class="proj-lead">{projeto.data.descricao_curta}</p>
        <Content />
      </div>
    </div>

    <!-- Galeria (se houver mais de uma imagem) -->
    {projeto.data.galeria.length > 1 && (
      <div class="proj-galeria section-inner">
        <p class="label">Galeria</p>
        <div class="gold-line"></div>
        <div class="galeria-grid">
          {projeto.data.galeria.map((img, i) => (
            <img
              src={img}
              alt={`${projeto.data.title} — foto ${i + 1}`}
              loading="lazy"
              data-lightbox-src={img}
            />
          ))}
        </div>
      </div>
    )}

    <!-- Nav prev/next -->
    <nav class="proj-nav section-inner" aria-label="Navegação entre projetos">
      <div class="proj-nav-inner">
        {prev ? (
          <a href={`/projetos/${prev.id}`} class="proj-nav-link">
            <span class="nav-dir">← Anterior</span>
            <span class="nav-title">{prev.data.title}</span>
          </a>
        ) : <div />}
        <a href="/portfolio" class="btn btn-outline-dark">Ver todos os projetos</a>
        {next ? (
          <a href={`/projetos/${next.id}`} class="proj-nav-link proj-nav-link--right">
            <span class="nav-dir">Próximo →</span>
            <span class="nav-title">{next.data.title}</span>
          </a>
        ) : <div />}
      </div>
    </nav>

    <CtaFinal />

  </main>
  <Lightbox />
  <Footer />
</Layout>

<style>
  /* ── Hero ─────────────────────────────────────────────── */
  .proj-hero {
    position: relative;
    height: 60vh;
    min-height: 400px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .proj-hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
  }

  .proj-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(24, 46, 48, 0.9) 0%,
      rgba(24, 46, 48, 0.35) 60%,
      transparent 100%
    );
  }

  .proj-hero-content {
    position: relative;
    z-index: 1;
    padding-bottom: 3.5rem;
    width: 100%;
  }

  .proj-hero-content h1 {
    color: var(--offwhite);
    margin-bottom: 0.75rem;
    font-size: clamp(2.25rem, 5vw, 3.5rem);
  }

  .proj-meta {
    font-size: 14px;
    font-weight: 300;
    color: rgba(240, 239, 245, 0.6);
    letter-spacing: 0.04em;
  }

  /* ── Corpo ────────────────────────────────────────────── */
  .proj-body {
    padding-top: 5rem;
    padding-bottom: 5rem;
  }

  .proj-content {
    max-width: 760px;
    margin: 0 auto;
  }

  .proj-lead {
    font-size: 19px;
    font-weight: 300;
    font-style: italic;
    line-height: 1.75;
    color: var(--muted);
    margin-bottom: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid rgba(33, 62, 64, 0.1);
  }

  /* prose */
  .prose {
    color: var(--verde);
    font-size: 16px;
    font-weight: 300;
    line-height: 1.8;
  }

  .prose :global(h2) {
    font-size: 1.375rem;
    font-weight: 600;
    margin: 2.5rem 0 1rem;
    letter-spacing: 0.01em;
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(p) {
    margin-bottom: 1.25rem;
    color: var(--muted);
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
    color: var(--muted);
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .prose :global(strong) {
    font-weight: 600;
    color: var(--verde);
  }

  /* ── Galeria ──────────────────────────────────────────── */
  .proj-galeria {
    padding-bottom: 5rem;
  }

  .galeria-grid {
    margin-top: 1.5rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1rem;
  }

  .galeria-grid img {
    width: 100%;
    height: 280px;
    object-fit: cover;
    border-radius: 10px;
    cursor: zoom-in;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .galeria-grid img:hover {
    transform: scale(1.02);
    box-shadow: 0 8px 32px rgba(33, 62, 64, 0.18);
  }

  /* ── Nav prev/next ────────────────────────────────────── */
  .proj-nav {
    padding-top: 3rem;
    padding-bottom: 5rem;
    border-top: 1px solid rgba(33, 62, 64, 0.1);
  }

  .proj-nav-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
  }

  .proj-nav-link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .proj-nav-link:hover {
    opacity: 0.75;
  }

  .proj-nav-link--right {
    text-align: right;
  }

  .nav-dir {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--dourado);
  }

  .nav-title {
    font-size: 15px;
    font-weight: 600;
    color: var(--verde);
  }

  @media (max-width: 768px) {
    .proj-hero {
      height: 50vh;
      min-height: 300px;
    }

    .proj-body {
      padding-top: 3rem;
      padding-bottom: 3rem;
    }

    .proj-lead {
      font-size: 17px;
    }

    .proj-galeria {
      padding-bottom: 3rem;
    }

    .galeria-grid {
      grid-template-columns: 1fr;
    }

    .galeria-grid img {
      height: 220px;
    }

    .proj-nav {
      padding-top: 2rem;
      padding-bottom: 3.5rem;
    }

    .proj-nav-inner {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 2rem;
    }

    .proj-nav-link--right {
      text-align: center;
    }
  }
</style>
