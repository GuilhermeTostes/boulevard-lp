---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import HeaderLP from '../components/HeaderLP.astro';
import FooterLP from '../components/FooterLP.astro';
import Metrics from '../components/Metrics.astro';
import Testimonials from '../components/Testimonials.astro';
import configs from '../content/configs.json';
import textos from '../content/textos.json';
import sobre from '../content/sobre.json';

const heroImage = textos.hero.imagem ?? 'https://picsum.photos/seed/boulevard-hero/1920/1280';
const paragrafos = sobre.body.split(/\n\n+/);

const allProjetos = await getCollection('projetos');
const projetos = allProjetos
  .sort((a, b) => a.data.ordem - b.data.ordem)
  .filter((p) => p.data.destaque)
  .slice(0, 6);
---

<Layout
  title="Boulevard Arq & Con: Do projeto às chaves, em Ribeirão Preto"
  description="Arquitetura e construção integradas em Ribeirão Preto. Uma equipe, um contrato, responsabilidade técnica integral. Solicite uma conversa."
>
  <HeaderLP />
  <main>

    <!-- ── HERO ──────────────────────────────────────────── -->
    <section id="hero" class="lp-hero">
      <div
        class="lp-hero-bg"
        role="img"
        aria-label="Projeto residencial Boulevard Arq & Con"
        style={`background-image: url('${heroImage}')`}
      ></div>
      <div class="lp-hero-overlay"></div>
      <div class="lp-hero-content">
        <p class="label">Arquitetura + Construção em Ribeirão Preto e Região</p>
        <div class="gold-line" style="margin: 14px 0 24px"></div>
        <h1>Transforme seu espaço com quem cuida de tudo, do projeto às chaves.</h1>
        <p class="lp-hero-subtitle">Sem obra improvisada. Sem projeto engavetado. A Boulevard reúne arquitetura e construção em uma única equipe, com responsabilidade técnica e presença em cada etapa.</p>
        <div class="lp-hero-ctas">
          <a href="#contato" class="btn btn-primary">
            Quero iniciar meu projeto
          </a>
        </div>
      </div>
    </section>

    <!-- ── FAIXA DE QUALIFICAÇÃO ─────────────────────────── -->
    <div class="lp-audience-strip">
      <div class="section-inner lp-audience-inner">
        <p class="lp-audience-text">
          <strong>Para quem é a Boulevard:</strong> atendemos projetos e obras residenciais e comerciais de alto padrão.
        </p>
      </div>
    </div>

    <!-- ── POR QUE A BOULEVARD ────────────────────────────── -->
    <section class="lp-valueprop">
      <div class="section-inner">
        <p class="label">Por que a Boulevard</p>
        <div class="gold-line"></div>
        <div class="lp-vp-grid">
          <div class="lp-vp-card">
            <p class="lp-vp-num">01</p>
            <h3 class="lp-vp-title">Do sonho ao projeto aprovado, sem perder a identidade.</h3>
            <p class="lp-vp-body">Cada projeto começa pela escuta. Desenvolvemos residências e espaços comerciais com identidade, funcionalidade e detalhamento técnico suficiente para que a execução aconteça exatamente como planejado.</p>
          </div>
          <div class="lp-vp-card">
            <p class="lp-vp-num">02</p>
            <h3 class="lp-vp-title">Obra acompanhada, cronograma respeitado, chaves na mão.</h3>
            <p class="lp-vp-body">Sua obra conduzida diretamente pelos sócios, do canteiro à entrega. Orçamento detalhado, cronograma claro e total transparência. Surpresa não faz parte do nosso processo.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── SERVIÇOS ───────────────────────────────────────── -->
    <section id="servicos" class="lp-services">
      <div class="section-inner">
        <div class="lp-services-header">
          <p class="label">O que fazemos</p>
          <div class="gold-line"></div>
          <h2 class="lp-services-title">Uma equipe. Projeto e obra.</h2>
        </div>
        <div class="lp-services-grid">
          <div class="lp-service-card">
            <p class="lp-service-num">I</p>
            <h3 class="lp-service-card-title">Projetos</h3>
            <p class="lp-service-body">Residenciais, comerciais ou corporativos: desenvolvemos projetos com rigor técnico e identidade autoral. Do estudo preliminar ao detalhamento executivo, com foco em transformar sua intenção em espaço construído.</p>
            <a href="#contato" class="btn-text">
              Solicitar orçamento <span aria-hidden="true">→</span>
            </a>
          </div>
          <div class="lp-service-card">
            <p class="lp-service-num">II</p>
            <h3 class="lp-service-card-title">Obras</h3>
            <p class="lp-service-body">Executamos obras completas com acompanhamento direto dos sócios em cada etapa. Reformas, construções e interiores, com cronograma, orçamento detalhado e responsabilidade técnica integral do início ao fim.</p>
            <a href="#contato" class="btn-text">
              Solicitar orçamento <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ── PORTFÓLIO ──────────────────────────────────────── -->
    <section class="lp-portfolio">
      <div class="section-inner">
        <div class="lp-port-header">
          <p class="label">Portfólio</p>
          <div class="gold-line" style="margin-bottom: 0"></div>
          <h2 style="margin-top: 1rem">Projetos realizados em Ribeirão Preto</h2>
        </div>
        <div class="lp-bento-grid">
          {projetos.map((projeto) => (
            <div class={`lp-project-card lp-tile-${projeto.data.tile_size}`}>
              <div
                class="lp-card-thumb"
                style={`background-image: url('${projeto.data.imagem_capa}')`}
              ></div>
              <div class="lp-card-overlay">
                <span class="lp-ov-tag">{projeto.data.tag}</span>
                <span class="lp-ov-title">{projeto.data.title}</span>
              </div>
              <div class="lp-card-info">
                <p class="lp-card-tag">{projeto.data.tag}</p>
                <p class="lp-card-title">{projeto.data.title}</p>
                <p class="lp-card-meta">{projeto.data.localizacao}, {projeto.data.ano}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── SOBRE ──────────────────────────────────────────── -->
    <section id="sobre" class="lp-about">
      <div class="lp-about-watermark" aria-hidden="true">
        <img src="/assets/symbol-gold.png" alt="" width="360" height="360" />
      </div>
      <div class="section-inner">
        <p class="label">{sobre.eyebrow}</p>
        <div class="gold-line"></div>
        <div class="lp-about-grid">
          <div class="lp-about-text">
            <h2 class="preserve-lines">{sobre.titulo}</h2>
            {paragrafos.map((p) => (
              <p class="lp-about-body">{p}</p>
            ))}
          </div>
          <div class="lp-about-partners">
            {sobre.socios.map((s, i) => (
              <article class="lp-partner-card" style={`--i:${i}`}>
                <div class="lp-partner-photo" aria-hidden={s.foto ? undefined : 'true'}>
                  {s.foto ? (
                    <img src={s.foto} alt={s.nome} loading="lazy" />
                  ) : (
                    <span class="lp-partner-initial">{s.nome.trim().charAt(0).toUpperCase()}</span>
                  )}
                </div>
                <div class="lp-partner-info">
                  <p class="lp-partner-role">{s.cargo}</p>
                  <p class="lp-partner-name">{s.nome}</p>
                  {s.bio && <p class="lp-partner-bio">{s.bio}</p>}
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ── MÉTRICAS ───────────────────────────────────────── -->
    <Metrics />

    <!-- ── DEPOIMENTOS ────────────────────────────────────── -->
    <Testimonials />

    <!-- ── FORMULÁRIO DE CONTATO ─────────────────────────── -->
    <section id="contato" class="lp-cta-final">
      <div class="lp-cta-rings" aria-hidden="true">
        <div class="lp-ring" style="width:500px;height:500px;"></div>
        <div class="lp-ring" style="width:340px;height:340px;"></div>
        <div class="lp-ring" style="width:180px;height:180px;"></div>
      </div>
      <div class="section-inner">
        <div class="lp-cta-inner">
          <img
            src="/assets/logo-vertical-light.png"
            alt="Boulevard Arq & Con"
            class="lp-cta-logo"
            width="1319"
            height="741"
          />
          <p class="label" style="margin-bottom: 1rem">Contato</p>
          <h2>Pronto para começar?</h2>
          <p class="lp-cta-sub">Antes de qualquer proposta, queremos conhecer você, entender o que deseja construir e apresentar como a Boulevard pode conduzir esse processo.</p>
          <form class="lp-cta-form" id="lpCtaForm">
            <input type="hidden" name="access_key" value="67f4590d-8fbc-4646-928c-9986a444b7c9" />
            <input type="hidden" name="subject" value="Novo contato — LP Boulevard" />
            <input type="hidden" name="from_name" value="Site Boulevard" />
            <input type="checkbox" name="botcheck" style="display: none;" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <input type="hidden" name="page_url" id="lpPageUrl" />
            <div class="lp-form-row">
              <input name="nome" type="text" required placeholder="Nome" autocomplete="name" />
              <input name="telefone" type="tel" required placeholder="Telefone" autocomplete="tel" />
            </div>
            <input name="email" type="email" required placeholder="E-mail" autocomplete="email" />
            <select name="interesse" required>
              <option value="" disabled selected>Qual é o seu interesse?</option>
              <option value="Projeto">Projeto</option>
              <option value="Obra">Obra</option>
              <option value="Projeto + Obra">Projeto + Obra</option>
            </select>
            <select name="prazo" required>
              <option value="" disabled selected>Quando pretende construir?</option>
              <option value="1 mês">Em até 1 mês</option>
              <option value="3 meses">Em até 3 meses</option>
              <option value="6 meses">Em até 6 meses</option>
              <option value="12 meses">Em até 12 meses</option>
              <option value="+12 meses">Mais de 12 meses</option>
            </select>
            <select name="orcamento" required>
              <option value="" disabled selected>Valor estimado da obra</option>
              <option value="Até R$ 300 mil">Até R$ 300 mil</option>
              <option value="Até R$ 500 mil">Até R$ 500 mil</option>
              <option value="Até R$ 1 milhão">Até R$ 1 milhão</option>
              <option value="Acima de R$ 1 milhão">Acima de R$ 1 milhão</option>
            </select>
            <textarea name="mensagem" rows="3" required placeholder="Nos conte mais sobre o que gostaria de realizar"></textarea>
            <button type="submit" class="btn btn-outline-light lp-form-submit">
              Enviar mensagem
            </button>
            <p class="lp-form-status" id="lpFormStatus" hidden></p>
          </form>
        </div>
      </div>
    </section>

  </main>
  <FooterLP />
</Layout>

<style>
  /* ── Hero ────────────────────────────────────────────── */
  .lp-hero {
    position: relative;
    width: 100%;
    min-height: 100dvh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .lp-hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center 40%;
  }

  .lp-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(24, 46, 48, 0.96) 0%,
      rgba(24, 46, 48, 0.72) 40%,
      rgba(24, 46, 48, 0.25) 100%
    );
  }

  .lp-hero-content {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: calc(var(--max-w) + var(--section-pad-x) * 2);
    margin: 0 auto;
    padding: 0 var(--section-pad-x) 5rem;
  }

  .lp-hero-content h1 {
    color: var(--offwhite);
    font-size: clamp(3rem, 6vw, 5rem);
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1.05;
    margin-bottom: 1.5rem;
    max-width: 20ch;
  }

  .lp-hero-subtitle {
    font-size: clamp(15px, 1.4vw, 17px);
    font-weight: 300;
    line-height: 1.75;
    color: rgba(240, 239, 245, 0.95);
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.4);
    max-width: 500px;
    margin-bottom: 2.5rem;
  }

  .lp-hero-content .label {
    display: inline-block;
    background: var(--dourado);
    border: none;
    border-radius: 100px;
    padding: 6px 18px;
    color: var(--verde-dk);
    letter-spacing: 0.12em;
  }

  .lp-hero-ctas {
    display: flex;
    gap: 0.875rem;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .lp-hero-content {
      padding: 0 var(--section-pad-x) 3.5rem;
    }
    .lp-hero-content h1 {
      font-size: clamp(2.5rem, 9vw, 3.25rem);
    }
  }

  /* ── Oculta botão flutuante de WhatsApp na LP ────────── */
  :global(.waf-btn) { display: none !important; }

  /* ── Faixa de qualificação ────────────────────────────── */
  .lp-audience-strip {
    background: var(--dourado);
    padding: 2.25rem 0;
    cursor: default;
    transition: background 0.3s var(--ease-premium);
  }

  .lp-audience-strip:hover {
    background: var(--dourado-h);
  }

  .lp-audience-inner {
    display: flex;
    justify-content: center;
  }

  .lp-audience-text {
    font-size: clamp(13px, 1.4vw, 15px);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 1.6;
    color: var(--verde-dk);
    text-align: center;
  }

  .lp-audience-text strong {
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  /* ── Value Prop ───────────────────────────────────────── */
  .lp-valueprop {
    background: var(--branco);
    padding: 7rem 0;
  }

  .lp-vp-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
    margin-top: 3rem;
    border: 1px solid rgba(33, 62, 64, 0.08);
    border-radius: 12px;
    overflow: hidden;
  }

  .lp-vp-card {
    padding: 3.25rem 3rem;
    background: var(--branco);
    position: relative;
    transition: background 0.3s var(--ease-premium);
  }

  .lp-vp-card:first-child {
    border-right: 1px solid rgba(33, 62, 64, 0.08);
  }

  .lp-vp-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--dourado);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s var(--ease-premium);
  }

  .lp-vp-card:hover::before {
    transform: scaleX(1);
  }

  .lp-vp-card:hover {
    background: var(--offwhite);
  }

  .lp-vp-num {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    color: var(--dourado);
    margin-bottom: 1.25rem;
  }

  .lp-vp-title {
    font-size: 1.625rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--verde);
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  .lp-vp-body {
    font-size: 15px;
    font-weight: 300;
    line-height: 1.8;
    color: rgba(33, 62, 64, 0.7);
  }

  @media (max-width: 768px) {
    .lp-valueprop { padding: 5rem 0; }
    .lp-vp-grid { grid-template-columns: 1fr; }
    .lp-vp-card:first-child {
      border-right: none;
      border-bottom: 1px solid rgba(33, 62, 64, 0.08);
    }
    .lp-vp-card { padding: 2.5rem 1.75rem; }
  }

  /* ── Serviços ─────────────────────────────────────────── */
  .lp-services {
    background: var(--branco);
    padding: 0 0 7rem;
  }

  .lp-services-header {
    margin-bottom: 3rem;
  }

  .lp-services-title {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 600;
    color: var(--verde);
    letter-spacing: -0.01em;
    margin-top: 1.25rem;
  }

  .lp-services-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .lp-service-card {
    background: var(--verde);
    border-radius: 12px;
    padding: 3.25rem 3rem;
    display: flex;
    flex-direction: column;
    transition:
      transform 0.4s var(--ease-premium),
      box-shadow 0.4s var(--ease-premium);
  }

  .lp-service-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 44px rgba(0, 0, 0, 0.18);
  }

  .lp-service-num {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(2.5rem, 4vw, 3.25rem);
    color: var(--dourado);
    line-height: 1;
    margin-bottom: 1.5rem;
  }

  .lp-service-card-title {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--branco);
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  .lp-service-body {
    font-size: 15px;
    font-weight: 300;
    line-height: 1.8;
    color: rgba(240, 239, 245, 0.82);
    flex: 1;
    margin-bottom: 2rem;
  }

  @media (max-width: 768px) {
    .lp-services { padding: 0 0 5rem; }
    .lp-services-grid { grid-template-columns: 1fr; }
    .lp-service-card { padding: 2.5rem 1.75rem; }
  }

  /* ── Portfólio ────────────────────────────────────────── */
  .lp-portfolio {
    background: var(--offwhite);
    padding: 7rem 0;
  }

  .lp-port-header {
    margin-bottom: 3.25rem;
  }

  .lp-bento-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-template-rows: auto auto;
    gap: 1.25rem;
  }

  .lp-tile-large  { grid-column: span 7; grid-row: span 2; }
  .lp-tile-wide   { grid-column: span 5; }
  .lp-tile-standard { grid-column: span 4; }

  .lp-project-card {
    display: block;
    border-radius: 12px;
    overflow: hidden;
    background: var(--branco);
    box-shadow: 0 2px 16px rgba(33, 62, 64, 0.08);
    cursor: default;
    position: relative;
    transition: box-shadow 0.4s var(--ease-premium);
  }

  .lp-project-card:hover {
    box-shadow: 0 10px 40px rgba(33, 62, 64, 0.14);
  }

  .lp-card-thumb {
    width: 100%;
    background-size: cover;
    background-position: center;
    transition: transform 0.6s var(--ease-premium);
  }

  .lp-tile-large .lp-card-thumb {
    height: 100%;
    position: absolute;
    inset: 0;
  }

  .lp-tile-wide .lp-card-thumb,
  .lp-tile-standard .lp-card-thumb {
    height: 220px;
  }

  .lp-tile-large {
    min-height: 420px;
    position: relative;
  }

  .lp-tile-large .lp-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(24,46,48,0.88) 0%, rgba(24,46,48,0.2) 60%, transparent 100%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 2rem;
    opacity: 0;
    transition: opacity 0.35s var(--ease-premium);
  }

  .lp-tile-large:hover .lp-card-overlay {
    opacity: 1;
  }

  .lp-tile-large .lp-card-info {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1.5rem 2rem;
    background: linear-gradient(to top, rgba(24,46,48,0.9) 0%, transparent 100%);
    transition: opacity 0.35s var(--ease-premium);
  }

  .lp-tile-large:hover .lp-card-info {
    opacity: 0;
  }

  .lp-tile-large .lp-card-info .lp-card-tag,
  .lp-tile-large .lp-card-info .lp-card-title {
    color: rgba(240, 239, 245, 0.9);
  }

  .lp-tile-large .lp-card-info .lp-card-meta {
    color: rgba(240, 239, 245, 0.55);
  }

  .lp-tile-wide .lp-card-overlay,
  .lp-tile-standard .lp-card-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 220px;
    background: rgba(33, 62, 64, 0.78);
    opacity: 0;
    transition: opacity 0.3s var(--ease-premium);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 1.5rem;
    text-align: center;
  }

  .lp-project-card:hover .lp-card-overlay {
    opacity: 1;
  }

  .lp-project-card:hover .lp-card-thumb {
    transform: scale(1.04);
  }

  .lp-ov-title {
    font-size: 15px;
    font-weight: 600;
    color: var(--offwhite);
    letter-spacing: 0.03em;
  }

  .lp-ov-tag {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--dourado);
  }

  .lp-card-info {
    padding: 1rem 1.125rem 1.125rem;
  }

  .lp-tile-large .lp-card-info {
    padding: 1.25rem 2rem;
  }

  .lp-card-tag {
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--dourado);
    margin-bottom: 4px;
  }

  .lp-card-title {
    font-size: 15px;
    font-weight: 600;
    color: var(--verde);
    margin-bottom: 4px;
  }

  .lp-card-meta {
    font-size: 12px;
    font-weight: 300;
    color: var(--muted);
  }

  @media (max-width: 768px) {
    .lp-portfolio { padding: 5rem 0; }
    .lp-bento-grid { grid-template-columns: 1fr; }
    .lp-tile-large,
    .lp-tile-wide,
    .lp-tile-standard { grid-column: 1 / -1; grid-row: auto; }
    .lp-tile-large { min-height: auto; }
    .lp-tile-large .lp-card-thumb { position: static; height: 260px; }
    .lp-tile-large .lp-card-overlay { display: none; }
    .lp-tile-large .lp-card-info {
      position: static;
      background: none;
      padding: 1rem 1.125rem 1.125rem;
    }
    .lp-tile-large .lp-card-info .lp-card-tag,
